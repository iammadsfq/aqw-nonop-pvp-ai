{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "turu": ["./src/sdk/turu.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/tools/**"]
}
