# Turu Headless Account Configuration
# Copy this file to .env and fill in your credentials (never commit .env)

TURU_USER=YourUsername
TURU_PASSWORD=YourPassword
TURU_SERVER=Artix

# Control API & Web Monitor settings
TURU_API=127.0.0.1:8791
TURU_MONITOR=127.0.0.1:8790
TURU_API_TOKEN=change_this_to_a_16_char_minimum_secret

# Optional: Custom data directory per bot instance (for multi-account 1v1 / 3v3 self-play)
# TURU_DATA_DIR=/home/saf/.local/share/Turu
RUST_LOG=warn,turu=info
